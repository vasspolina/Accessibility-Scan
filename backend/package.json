{
  "name": "a11y-checker-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:widget": "mkdir -p public && cd ../widget && npm run build && cp dist/widget.js ../backend/public/widget.js",
    "build:widget-business": "mkdir -p public && cd ../widget-business && npm run build && cp dist/widget-business.js ../backend/public/widget-business.js",
    "build:widgets": "npm run build:widget && npm run build:widget-business",
    "start": "node dist/server.js",
    "test": "vitest run",
    "playwright:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.2",
    "@fastify/static": "^8.0.3",
    "axe-core": "^4.10.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "html-validate": "^11.5.6",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "1.61.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
