{
  "name": "a11y-scan",
  "version": "1.0.0",
  "description": "Accessibility scan for a pipeline: WCAG 2.2 and EN 301 549 findings from a real browser, with thresholds, a baseline, SARIF, JUnit and tickets.",
  "license": "EUPL-1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasspolina/Accessibility-Scan.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/vasspolina/Accessibility-Scan/blob/main/docs/CLI.md",
  "keywords": ["accessibility", "a11y", "wcag", "en-301-549", "axe-core", "playwright", "ci", "sarif"],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:widget": "mkdir -p public && cd ../widget && npm run build && cp dist/widget.js ../backend/public/widget.js",
    "build:widget-business": "mkdir -p public && cd ../widget-business && npm run build && cp dist/widget-business.js ../backend/public/widget-business.js",
    "build:widgets": "npm run build:widget && npm run build:widget-business",
    "start": "node dist/server.js",
    "test": "vitest run",
    "playwright:install": "playwright install --with-deps chromium",
    "scan": "node dist/cli.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/sensible": "^6.0.2",
    "@fastify/static": "^8.0.3",
    "axe-core": "^4.14.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "html-validate": "^11.5.6",
    "pdfjs-dist": "^4.10.38",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "1.61.1",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "bin": {
    "a11y-scan": "dist/cli.js",
    "a11y-scan-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
