# Copy this file to `.env` in the same folder and fill in your values —
# .env is gitignored, so your key stays on your machine and is never
# committed. The server reads it automatically on startup.

# Required for the AI judgment layer (AI review + alt-text suggestions).
# Get a key at https://console.anthropic.com -> Settings -> API keys.
# Without this, /api/scan still works using the automated axe-core layer
# only (aiReviewStatus: "skipped_no_key").
ANTHROPIC_API_KEY=

# Server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated list of allowed embedding origins for CORS.
# Use "*" to allow any origin (required if the widget will be embedded on
# third-party client sites you don't control in advance).
ALLOWED_ORIGINS=*

# Rate limiting
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# Timeouts (ms)
RENDER_TIMEOUT_MS=20000
AI_REVIEW_TIMEOUT_MS=20000

# Max concurrent Playwright pages
MAX_CONCURRENT_RENDERS=6
