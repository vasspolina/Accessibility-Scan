# Copy this file to `.env` in the same folder and fill in your values —
# .env is gitignored, so your key stays on your machine and is never
# committed. The server reads it automatically on startup.

# Required for the AI judgment layer (AI review + alt-text suggestions).
# Get a key at https://console.anthropic.com -> Settings -> API keys.
# Without this, /api/scan still works using the automated axe-core layer
# only (aiReviewStatus: "skipped_no_key").
ANTHROPIC_API_KEY=

# Server
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated list of allowed embedding origins for CORS.
# Use "*" to allow any origin (required if the widget will be embedded on
# third-party client sites you don't control in advance).
ALLOWED_ORIGINS=*

# Rate limiting. RATE_LIMIT_MAX guards the expensive thing — a browser
# render — so it is deliberately tight. The storage-backed routes are SQLite
# reads and get their own, much higher, allowance: at five a minute, working
# through a site's twenty-odd manual questions took most of an hour.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000
STORED_RATE_LIMIT_MAX=120

# Timeouts (ms)
RENDER_TIMEOUT_MS=20000
AI_REVIEW_TIMEOUT_MS=20000

# Max concurrent Playwright pages
MAX_CONCURRENT_RENDERS=6

# Storage — accounts, scan history, and recorded manual verdicts.
# Absent by default. With no DB_PATH the scanner runs exactly as it always
# has (anonymous, nothing saved) and those routes answer 501 "Not set up"
# rather than failing silently.
#
# DB_DURABLE is YOUR statement that DB_PATH is inside a mounted volume. It
# cannot be detected from inside the process: a container path and a volume
# path look identical, and the difference — that the first is erased on every
# deploy — only shows up after the data is gone. Only true/1/yes/on turn it
# on; anything else, a typo included, leaves it off.
# DB_PATH=/data/a11y.db
# DB_DURABLE=true

# Gate on creating accounts and minting API keys. Without it those routes are
# closed entirely, not open to anyone who finds them.
# ADMIN_TOKEN=
